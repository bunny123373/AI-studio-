# ---------------------------------------------------------------------------
# BALU AI STUDIO — environment variables
# Copy this file to `.env.local` and fill in what you need.
# All API keys are optional. The app works without any of them:
# template engines and free providers are used automatically.
# Never commit .env / .env.local. Secrets never leave the server.
# ---------------------------------------------------------------------------

# --- AI TEXT PROVIDER -------------------------------------------------------
# "template"  = offline rule/template generators (default, always works)
# "openai"    = any OpenAI-compatible API (OpenAI, Groq, Together, DeepSeek,
#               LM Studio, Ollama (OpenAI mode), local vLLM, etc.)
# "openrouter" = OpenRouter — default model inclusionai/ling-3.0-flash-vl
#               (Ling 3.0 Flash VL: a vision-language model for text; it can
#               refine image prompts but cannot generate images itself)
# "gemini"    = Google Gemini (HUGGINGFACE/GEMINI key not required for template)
# AI_TEXT_PROVIDER=template
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- AI IMAGE PROVIDER ------------------------------------------------------
# "gemini"       = Google Gemini image model (default). Needs GEMINI_API_KEY
#                  AND billing enabled — the free tier has 0 image quota.
# "huggingface"  = Hugging Face Inference Providers (needs HUGGINGFACE_API_KEY)
# "pollinations" = free image generation, internet required. Works keyless via
#                  the legacy free tier (can be busy). For reliable images, add
#                  a free Quest-Pollen key from enter.pollinations.ai:
# POLLINATIONS_API_KEY=
# "local"        = local Stable Diffusion / ComfyUI compatible server
# "none"         = disable image generation (UI shows setup instructions)
# The image tools' engine picker also offers "openrouter": OPENROUTER_API_KEY
# is used to refine the prompt with Ling 3.0 Flash VL, then the image is
# painted by free Pollinations (Ling cannot generate images on its own).
# IMAGE_PROVIDER=gemini
# Gemini image model to call (e.g. gemini-3.1-flash-image).
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Hugging Face image engine — model + router base URL.
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/hf-inference/models
# HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
# LOCAL_SD_URL=http://127.0.0.1:7860

# --- AUDIO / SRT (audio-to-srt tool) ---------------------------------------
# Runs the REAL local engine (faster-whisper), so it needs Python on the same
# host as the app. Serverless hosts (Vercel/Netlify) cannot run it — deploy the
# repo's Dockerfile / render.yaml on Render for a public URL that can.
# Whisper model for faster-whisper (tiny|base|small|medium|large-v3).
# Larger models = more accurate, need more RAM/VRAM, slower.
# WHISPER_MODEL=small
# Max upload size in MB (default 200).
# MAX_AUDIO_MB=200
# Working directory for uploaded audio + job state (default ./tmp-audio).
# AUDIO_WORK_DIR=./tmp-audio
# How long to keep processed audio files, hours (0 = delete immediately).
# AUDIO_RETENTION_HOURS=0
# Path to ffmpeg. If empty, the app auto-detects it (also checks the
# Python imageio-ffmpeg bundle used by this project's pipeline).
# FFMPEG_PATH=
# Path to yt-dlp for transcriptions from a YouTube URL. If empty the app
# auto-detects it on PATH. Install with: pip install yt-dlp
# YTDLP_PATH=
# Python interpreter used for the local engine. Empty = "python" (Windows /
# most desktops). Debian/Ubuntu images only ship "python3" — the Dockerfile
# sets PYTHON_BIN=python3.
# PYTHON_BIN=
# Optional speaker labels (diarization) on subtitle lines. Needs
# `pip install pyannote.audio` (PyTorch, heavier) AND a Hugging Face token.
# Accept the terms of the gated model pyannote/speaker-diarization-3.1 first.
# PYANNOTE_AUTH_TOKEN=
# Bilingual subtitles: any configured TEXT AI provider (AI_TEXT_PROVIDER
# above) is used to translate subtitle lines. No extra variable needed.

# --- RATE LIMITING ----------------------------------------------------------
# Basic in-memory rate limit: requests per window per IP.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000

# --- DEV ONLY ---------------------------------------------------------------
# Expose the runtime text provider/model switcher in Settings. Hidden in
# production unless set to "1".
# ALLOW_RUNTIME_SWITCHER=