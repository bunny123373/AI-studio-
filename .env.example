# ---------------------------------------------------------------------------
# BALU AI STUDIO — environment variables
# Copy this file to `.env.local` and fill in what you need.
# All API keys are optional. The app works without any of them:
# template engines and free providers are used automatically.
# Never commit .env / .env.local. Secrets never leave the server.
# ---------------------------------------------------------------------------

# --- AI TEXT PROVIDER -------------------------------------------------------
# "template"  = offline rule/template generators (default, always works)
# "openai"    = any OpenAI-compatible API (OpenAI, Groq, Together, DeepSeek,
#               LM Studio, Ollama (OpenAI mode), local vLLM, etc.)
# "gemini"    = Google Gemini (HUGGINGFACE/GEMINI key not required for template)
# AI_TEXT_PROVIDER=template
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# --- AI IMAGE PROVIDER ------------------------------------------------------
# "pollinations" = free image generation, no API key, internet required (default)
# "local"        = local Stable Diffusion / ComfyUI compatible server
# "none"         = disable image generation (UI shows setup instructions)
# IMAGE_PROVIDER=pollinations
# LOCAL_SD_URL=http://127.0.0.1:7860
# HUGGINGFACE_API_KEY=

# --- AUDIO / SRT (audio-to-srt tool) ---------------------------------------
# Whisper model for faster-whisper (tiny|base|small|medium|large-v3).
# Larger models = more accurate, need more RAM/VRAM, slower.
# WHISPER_MODEL=small
# Max upload size in MB (default 200).
# MAX_AUDIO_MB=200
# Working directory for uploaded audio + job state (default ./tmp-audio).
# AUDIO_WORK_DIR=./tmp-audio
# How long to keep processed audio files, hours (0 = delete immediately).
# AUDIO_RETENTION_HOURS=0
# Path to ffmpeg. If empty, the app auto-detects it (also checks the
# Python imageio-ffmpeg bundle used by this project's pipeline).
# FFMPEG_PATH=

# --- RATE LIMITING ----------------------------------------------------------
# Basic in-memory rate limit: requests per window per IP.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000